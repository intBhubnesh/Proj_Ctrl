# ============================================
# BrainFlow - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Database Configuration
# ============================================
# For Docker: use 'postgres' as hostname
# For Local: use 'localhost' as hostname

DATABASE_URL="postgresql://admin:password@postgres:5432/college_db"
DIRECT_URL="postgresql://admin:password@postgres:5432/college_db"

# For local development (without Docker):
# DATABASE_URL="postgresql://admin:password@localhost:5432/college_db"
# DIRECT_URL="postgresql://admin:password@localhost:5432/college_db"

# For NeonDB (cloud PostgreSQL):
# DATABASE_URL="postgresql://username:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL="postgresql://username:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require"

# ============================================
# NextAuth Configuration
# ============================================
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-min-32-chars"

# Application URL (change for production)
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Google OAuth Credentials
# ============================================
# Get these from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# API Configuration
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ============================================
# Plagiarism Detection Service (Optional)
# ============================================
# Required only if you want to use the plagiarism detection feature
# Get OpenAI API key from: https://platform.openai.com/api-keys
# Get Pinecone API key from: https://www.pinecone.io/

OPENAI_API="your-openai-api-key"
PINECONE_API_KEY="your-pinecone-api-key"

# Plagiarism Service URL
# For Docker: use 'http://plagiarism-checker:5000'
# For Local: use 'http://localhost:5001'
PLAGIARISM_SERVICE_URL="http://plagiarism-checker:5000"

# ============================================
# Environment Mode
# ============================================
NODE_ENV="development"

# ============================================
# Production Configuration (Optional)
# ============================================
# Uncomment and configure these for production deployment

# Production Database (e.g., NeonDB, Supabase, Railway)
# DATABASE_URL="postgresql://user:password@your-production-db-host:5432/brainflow_prod"
# DIRECT_URL="postgresql://user:password@your-production-db-host:5432/brainflow_prod"

# Production URLs
# NEXTAUTH_URL="https://yourdomain.com"
# NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# Production Google OAuth (create separate credentials for production)
# GOOGLE_CLIENT_ID="your-prod-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-prod-client-secret"

# ============================================
# Notes
# ============================================
# 1. Never commit the .env file to version control
# 2. Keep your secrets secure and rotate them regularly
# 3. Use different credentials for development and production
# 4. For Docker deployment, use service names (postgres, plagiarism-checker)
# 5. For local development, use localhost
