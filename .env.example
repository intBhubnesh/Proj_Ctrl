# Database Configuration
# Replace with your actual NeonDB connection string from Neon Console
# Format: postgresql://[username]:[password]@[endpoint].neon.tech/[database]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require"

# Direct URL for Prisma (same as DATABASE_URL for Neon)
DIRECT_URL="postgresql://username:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Optional: Email Configuration (for notifications)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Optional: File Storage (AWS S3, Google Cloud, etc.)
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Optional: JWT Secret for authentication
JWT_SECRET=""

# Optional: App Configuration
APP_NAME="ProjectCtrl"
APP_URL="http://localhost:3000"

# Local PostgreSQL (alternative to NeonDB for development)
# DATABASE_URL="postgresql://admin:password@localhost:5432/college_db"
# DIRECT_URL="postgresql://admin:password@localhost:5432/college_db"
