// -------------------------------------------------------
// ProjectCtrl – Prisma Schema (PostgreSQL)
// -------------------------------------------------------
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------- Enums --------------------------
enum UserRole {
  STUDENT
  TEACHER     // Mentor
  ADMIN
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum SubmissionStatus {
  PENDING_CHECK
  CHECKING
  CLEAN
  FLAGGED
  RESUBMIT_REQUIRED
  FINALIZED
}

enum PlagiarismStatus {
  CLEAN
  SUSPICIOUS
  PLAGIARIZED
}

enum AssessmentStatus {
  NOT_ASSESSED
  IN_REVIEW
  GRADED
  LOCKED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ContributionValidationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// ---------------------- NextAuth Tables ----------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationTokenAuth {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------- Core Users ---------------------
model User {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Auth/identity
  email               String               @unique           // Google login email; must be college domain for students/teachers
  emailVerified       DateTime?            // NextAuth requirement
  image               String?              // NextAuth requirement
  name                String?
  password            String?              // Hashed password for credentials login (optional, for admin/manual accounts)
  role                UserRole?

  // NextAuth relations
  accounts            Account[]
  sessions            Session[]

  // College identity (for student/teacher)
  enrollmentNo        String?              @unique
  collegeEmail        String?                                 // same as 'email' if using official domain

  // External ERP sync state
  externalSyncStatus  String               @default("PENDING") // PENDING | SYNCED | FAILED
  syncedAt            DateTime?

  // Profiles (one of these typically)
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  adminProfile        AdminProfile?

  // OTP/verification + audit
  verificationTokens  VerificationToken[]
  auditLogs           AuditLog[]

  // Mentor/team relations
  assignedMentorTeams TeamMentorAssignment[] @relation("MentorUser")
  assignedByMentorHistory TeamMentorAssignment[] @relation("AssignedByAdmin")

  // Team relations
  ledTeams            Team[]               @relation("TeamLeader")
  currentMentorForTeams Team[]             @relation("CurrentMentorOnTeam")

  // Files and submissions
  uploadedFiles       ProjectFile[]
  submissions         Submission[]         @relation("SubmissionUser")

  // Assessments
  assessments         Assessment[]         @relation("AssessmentMentor")

  // Notifications/Emails
  userNotifications   UserNotification[]
  emailJobs           EmailJobRecipient[]
  createdNotifications Notification[]
  createdEmailJobs    EmailJob[]

  // Weekly Reports
  weeklyReports       WeeklyReport[]

  // External Sync Logs
  externalSyncLogs    ExternalSyncLog[]

  @@index([role])
}

// ---------------------- Profiles -----------------------
model StudentProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // From ERP (kept in profile for fast filter)
  department       String
  semester         Int?
  division         String?
  institution      String?
  course           String?

  // enforce 'one active team at a time'
  currentTeamId    String?
  currentTeam      Team?         @relation(fields: [currentTeamId], references: [id])

  // history
  memberships      TeamMembership[]

  @@index([department])
  @@index([currentTeamId])
}

model TeacherProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  expertise        String?    // free text or CSV; normalize later if needed
  technologies     String?    // free text or CSV
  department       String?    // optional primary department
}

model AdminProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------- Teams --------------------------
model Team {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  name             String
  code             String           @unique // invite/join code

  leaderUserId     String           @unique
  leader           User             @relation("TeamLeader", fields: [leaderUserId], references: [id])

  // Department lock (all members must match leader/this department)
  department       String

  // Team validation status
  isValidated      Boolean          @default(false) // true after successful submission and plagiarism check
  submittedAt      DateTime?        // when team was submitted for validation
  validatedAt      DateTime?        // when team was approved

  // membership & mapping
  memberships      TeamMembership[]
  mentorAssignments TeamMentorAssignment[]
  currentMentorId  String?          // convenience pointer to active mentor (User.id)
  currentMentor    User?            @relation("CurrentMentorOnTeam", fields: [currentMentorId], references: [id])

  // project content
  project          Project?

  // assessment summary (optional denormalization)
  latestAssessmentId String?        @unique
  latestAssessment  Assessment?     @relation(fields: [latestAssessmentId], references: [id])
  isVerified        Boolean         @default(false)

  // weekly reports
  weeklyReports     WeeklyReport[]

  // current students (one-to-many with StudentProfile)
  currentStudents   StudentProfile[]

  @@index([currentMentorId])
  @@index([department])
}

model TeamMembership {
  id               String           @id @default(cuid())
  teamId           String
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  role             TeamMemberRole   @default(MEMBER)
  memberDeclaredRole String?        // custom role text shown under name (must be filled by each member)
  joinedAt         DateTime         @default(now())
  leftAt           DateTime?

  // Prevent duplicates in same team for the same student (per join event)
  @@unique([teamId, studentProfileId, joinedAt])
  @@index([studentProfileId])
}

// Mentor assignment history with admin who mapped
model TeamMentorAssignment {
  id               String     @id @default(cuid())
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  mentorUserId     String
  mentor           User       @relation("MentorUser", fields: [mentorUserId], references: [id])

  assignedByUserId String
  assignedBy       User       @relation("AssignedByAdmin", fields: [assignedByUserId], references: [id])

  assignedAt       DateTime   @default(now())
  endedAt          DateTime?

  @@index([mentorUserId])
  @@index([teamId, assignedAt])
}

// ---------------------- Projects -----------------------
model Project {
  id               String       @id @default(cuid())
  teamId           String       @unique
  team             Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // leader-editable fields
  technology       String
  domain           String
  problemStatement String

  // links & files
  repoUrl          String?
  srsReportId      String?       // latest SRS file
  srsReport        ProjectFile?  @relation("ProjectSRS", fields: [srsReportId], references: [id])
  pptUrl           String?

  submissions      Submission[]
  assessments      Assessment[]

  @@index([domain])
}

// Generic file bucket (S3/GCS/etc.)
model ProjectFile {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())

  storageUrl       String     // S3/GCS URL or path
  fileName         String
  mimeType         String
  sizeBytes        Int
  sha256           String?    // integrity check
  uploadedByUserId String
  uploadedBy       User       @relation(fields: [uploadedByUserId], references: [id])

  // Relations
  srsInProjects    Project[]  @relation("ProjectSRS")
  submissions      Submission[]
}

// ---------------------- Submissions & Plagiarism -------
model Submission {
  id                   String                     @id @default(cuid())
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  projectId            String
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submittedByUserId    String
  submittedBy          User                       @relation("SubmissionUser", fields: [submittedByUserId], references: [id])

  attemptNo            Int
  status               SubmissionStatus           @default(PENDING_CHECK)

  reportFileId         String?                    // report/PDF for this attempt (could be same as SRS or consolidated project)
  reportFile           ProjectFile?               @relation(fields: [reportFileId], references: [id])

  repoUrl              String?                    // override or confirm repo for this submission
  notes                String?

  // Plagiarism & contribution
  plagiarismReport     PlagiarismReport?
  uniqueContribution   String?                    // required when similarityPct > 80
  contributionStatus   ContributionValidationStatus @default(NOT_REQUIRED)

  assessment           Assessment?                // optional direct link if mentor graded this submission

  @@unique([projectId, attemptNo])
  @@index([status])
}

model PlagiarismReport {
  id                   String            @id @default(cuid())
  createdAt            DateTime          @default(now())

  submissionId         String            @unique
  submission           Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  similarityPct        Float
  status               PlagiarismStatus
  reasonsJson          Json?             // highlights, matched sources, etc.
  modelVersion         String?
  datasetTag           String?
  summary              String?           // AI-generated summary for transparency
}

// ---------------------- Assessment ---------------------
model Assessment {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submissionId     String?          @unique // which submission was graded
  submission       Submission?      @relation(fields: [submissionId], references: [id])

  mentorUserId     String           // who graded
  mentor           User             @relation("AssessmentMentor", fields: [mentorUserId], references: [id])

  status           AssessmentStatus  @default(NOT_ASSESSED)
  totalMarks       Int?
  rubricJson       Json?            // optional rubric breakdown
  remarks          String?

  // Team that this is the latest assessment for
  latestForTeam    Team?

  @@index([mentorUserId])
  @@index([projectId])
}

// ---------------------- Weekly Reports -----------------
model WeeklyReport {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())

  teamId           String
  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  authorUserId     String
  author           User       @relation(fields: [authorUserId], references: [id])

  weekLabel        String     // e.g., "2025-W12" or "Week 3"
  content          String     @db.Text // 200 words limit enforced in app layer
  imageUrls        String[]   // 1–3 URLs, validated in app layer

  @@unique([teamId, weekLabel])
  @@index([authorUserId])
}

// ---------------------- Notifications & Email ----------
model Notification {
  id               String               @id @default(cuid())
  createdAt        DateTime             @default(now())

  title            String
  message          String
  channel          NotificationChannel  @default(IN_APP)
  priority         NotificationPriority @default(NORMAL)

  templateKey      String?              // for templated notifications
  createdByUserId  String
  createdBy        User                 @relation(fields: [createdByUserId], references: [id])

  // recipients
  recipients       UserNotification[]
}

model UserNotification {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationId   String
  notification     Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  readAt           DateTime?
  deliveredAt      DateTime?     // for EMAIL deliveries

  @@unique([userId, notificationId])
  @@index([readAt])
}

// Bulk email batching (filter → recipients)
model EmailJob {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())
  createdByUserId  String
  createdBy        User        @relation(fields: [createdByUserId], references: [id])

  subject          String
  bodyHtml         String
  filterJson       Json        // stores the applied filter (e.g., teams with FLAGGED submissions, etc.)
  status           String      @default("QUEUED") // QUEUED|SENDING|DONE|FAILED

  recipients       EmailJobRecipient[]
}

model EmailJobRecipient {
  id               String     @id @default(cuid())
  emailJobId       String
  emailJob         EmailJob   @relation(fields: [emailJobId], references: [id], onDelete: Cascade)

  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentAt           DateTime?
  status           String      @default("PENDING") // PENDING|SENT|FAILED
  errorMessage     String?

  @@unique([emailJobId, userId])
  @@index([status])
}

// ---------------------- Verification & Audit -----------
model VerificationToken {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  token            String     @unique
  type             String     // EMAIL_VERIFICATION, PASSWORD_RESET, etc.
  expiresAt        DateTime
  usedAt           DateTime?

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())

  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  action           String     // LOGIN, LOGOUT, CREATE_PROJECT, etc.
  entityType       String?    // Team, Project, Submission, etc.
  entityId         String?    // ID of the affected entity
  metadata         Json?      // additional context
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------- External ERP Sync --------------
model ExternalSyncLog {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  erpNumber        String
  requestPayload   Json?
  responsePayload  Json?
  status           String      // SUCCESS | FAILED
  errorMessage     String?

  @@index([userId, createdAt])
  @@index([erpNumber])
}

// ---------------------- RAG / Knowledge Base -----------
model KnowledgeBaseDoc {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  title            String
  sourceType       String     // e.g., POLICY, DEADLINE
}
